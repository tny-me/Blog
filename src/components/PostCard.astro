---
interface Props {
  title: string;
  slug: string;
  date: Date;
  type?: string;
  description?: string;
  image?: string;
  tags?: string[];
}

const { title, slug, date, type = 'general', description, image, tags = [] } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const postUrl = `${base}posts/${slug}`;

const dateFormatted = date.toLocaleDateString('es-MX', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
});

const typeLabels: Record<string, string> = {
  reflexion: 'Reflexión',
  carta: 'Carta',
  fe: 'Fe',
  espiritu: 'Espíritu',
  general: 'Entrada',
};

// Iniciales del título, como la insignia de cada fila.
const initials = title
  .replace(/[^\p{L}\p{N}\s]/gu, '')
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((w) => w[0].toUpperCase())
  .join('');
---

<li class="row">
  <span class="row-mark" aria-hidden="true">{initials}</span>
  <div>
    <h2 class="row-title"><a href={postUrl}>{title}</a></h2>
    <span class="row-crumb">{typeLabels[type] ?? type}{tags[0] ? ` → ${tags[0]}` : ""}</span>
    {description && <p class="row-excerpt">{description}</p>}
    <div class="row-foot">
      <span class="row-date">{dateFormatted}</span>
      {tags.slice(0, 3).map((tag) => <span class="tag">#{tag}</span>)}
    </div>
    {image && <img class="row-thumb" src={image} alt={title} loading="lazy" />}
  </div>
</li>
