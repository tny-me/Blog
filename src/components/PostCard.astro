---
interface Props {
  title: string;
  slug: string;
  date: Date;
  type?: string;
  description?: string;
  image?: string;
}

const { title, slug, date, type = 'general', description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const postUrl = `${base}posts/${slug}`;

const dateFormatted = date.toLocaleDateString('es-MX', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});

const typeLabels: Record<string, string> = {
  reflexion: 'reflexión',
  carta: 'carta',
  fe: 'fe',
  espiritu: 'espíritu',
  general: '',
};
---

<li class="post-card">
  <div class="post-card-title">
    <a href={postUrl}>{title}</a>
    {description && <span style="display:block; font-size:0.8rem; color:var(--muted); font-weight:400; margin-top:0.2rem;">{description}</span>}
  </div>
  <div class="post-card-right">
    <time class="post-date" datetime={date.toISOString()}>{dateFormatted}</time>
    {type !== 'general' && <span class="post-type">{typeLabels[type]}</span>}
  </div>
</li>
