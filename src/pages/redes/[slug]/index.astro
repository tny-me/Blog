---
import '../../../styles/global.css';
import { getCollection } from 'astro:content';
import { prepararCarrusel } from '../../../lib/carrusel';
import { resumenDe } from '../../../lib/resumen';
import { categoryColor } from '../../../lib/slug';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const carrusel = prepararCarrusel(post.body);
const enlace = new URL(`${base}posts/${post.slug}/`, Astro.site).href;
const color = categoryColor(post.data.category);

const laminas = Array.from({ length: carrusel.total }, (_, i) => {
  const n = i + 1;
  return {
    n,
    src: `${base}redes/img/${post.slug}-${n}.png`,
    papel: n === 1 ? 'Portada' : n === carrusel.total ? 'Cierre' : `Contenido ${n - 1}`,
  };
});

// Aviso de lo que no cabe en un carrusel de texto.
const { tablas, diagramas, imagenes, videos } = carrusel.omitidos;
const omitidos = [
  tablas && `${tablas} ${tablas === 1 ? 'tabla' : 'tablas'}`,
  diagramas && `${diagramas} ${diagramas === 1 ? 'diagrama' : 'diagramas'}`,
  imagenes && `${imagenes} ${imagenes === 1 ? 'imagen' : 'imágenes'}`,
  videos && `${videos} ${videos === 1 ? 'vídeo' : 'vídeos'}`,
].filter(Boolean) as string[];
const unSoloOmitido = tablas + diagramas + imagenes + videos === 1;
const avisoOmitidos = omitidos.length === 0 ? null
  : `No se ${unSoloOmitido ? 'incluye' : 'incluyen'} ${omitidos.join(', ')}: ` +
    `un carrusel de texto no ${unSoloOmitido ? 'lo' : 'los'} representa bien.`;

// Pie listo para pegar en la publicación.
const etiquetas = (post.data.tags ?? []).map((t: string) => '#' + t.replace(/[^\p{L}\p{N}]/gu, '')).join(' ');
const pieSugerido = [
  post.data.title,
  '',
  resumenDe(post.body, post.data.description, 180),
  '',
  `Artículo completo: ${enlace}`,
  etiquetas,
].filter((l) => l !== undefined).join('\n').trim();
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Carrusel — {post.data.title}</title>
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <script is:inline>
    const t = localStorage.getItem('theme') ??
      (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    document.documentElement.setAttribute('data-theme', t);
  </script>
</head>

<body>
  <header class="ed-bar">
    <span class="reader-crumb">
      <a href={`${base}editor`} class="btn">←</a>
      <span class="rail-swatch" style={`background:${color}`}></span>
      <span>{post.data.title}</span>
      <span class="pill">{carrusel.total} láminas</span>
    </span>
    <span class="reader-acts">
      <a class="btn" href={`${base}posts/${post.slug}/`} target="_blank" rel="noopener">Ver entrada</a>
      <button class="btn btn-primary" id="bajar-todas" type="button">Descargar todas</button>
    </span>
  </header>

  <main class="redes">
    <p class="ed-note">
      Láminas de 1080×1350, la proporción que Instagram y LinkedIn muestran sin recortar.
      La última lleva el enlace al artículo.
      {carrusel.recortados > 0 && (
        <> Este artículo no cabe entero: Instagram y LinkedIn admiten 20 imágenes por
        carrusel, así que se usaron las 20 y quedaron fuera {carrusel.recortados} bloques
        de texto — que es justo para lo que sirve la última lámina con el enlace.</>
      )}
      {avisoOmitidos && <>{' '}{avisoOmitidos}</>}
    </p>

    <!-- Si el sitio aún no ha terminado de publicarse, las láminas no existen todavía. -->
    <div class="redes-aviso" id="redes-aviso" hidden>
      <p>
        <strong id="redes-aviso-texto"></strong>
        Las láminas se generan al publicar el sitio, y eso tarda un par de minutos
        desde que guardas la entrada.
      </p>
      <button class="btn btn-primary" id="redes-reintentar" type="button">Reintentar</button>
    </div>

    <section class="redes-pie">
      <p class="eyebrow">Texto para la publicación</p>
      <pre id="pie-texto">{pieSugerido}</pre>
      <button class="btn" id="copiar-pie" type="button">Copiar texto</button>
    </section>

    <div class="redes-rejilla">
      {laminas.map((lamina) => (
        <figure class="redes-lamina" data-nombre={`${post.slug}-${lamina.n}.png`}>
          <img src={lamina.src} alt={`Lámina ${lamina.n}`} loading="lazy" width="1080" height="1350" />
          <div class="redes-hueco">Todavía no publicada</div>
          <figcaption>
            <span>{lamina.n}. {lamina.papel}</span>
            <a class="btn" href={lamina.src} download={`${post.slug}-${lamina.n}.png`}>Descargar</a>
          </figcaption>
        </figure>
      ))}
    </div>
  </main>
</body>

<style is:global>
  .redes { padding: 1.5rem 1.75rem 5rem; max-width: 1200px; margin: 0 auto; }
  .redes > .ed-note { max-width: 80ch; margin-bottom: 1.5rem; }

  .redes-aviso {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    border: 1px solid var(--border);
    border-left: 3px solid #D9730D;
    border-radius: 8px;
    padding: 0.9rem 1.1rem;
    margin-bottom: 1.5rem;
    background: var(--rail);
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--muted);
  }
  .redes-aviso p { margin: 0; max-width: 70ch; }
  .redes-aviso strong { color: var(--text); }

  .redes-pie {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1rem 1.1rem;
    margin-bottom: 2rem;
    background: var(--rail);
  }
  .redes-pie .eyebrow { display: block; margin-bottom: 0.6rem; }
  .redes-pie pre {
    white-space: pre-wrap;
    font-family: inherit;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text);
    margin-bottom: 0.75rem;
  }

  .redes-rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.25rem;
  }
  .redes-lamina {
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    background: var(--bg);
  }
  .redes-lamina img { width: 100%; height: auto; display: block; border-bottom: 1px solid var(--border); }
  .redes-lamina figcaption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.5rem 0.6rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  /* Marca de hueco: en lugar del icono de imagen rota del navegador. */
  .redes-hueco {
    display: none;
    aspect-ratio: 1080 / 1350;
    place-items: center;
    text-align: center;
    padding: 1rem;
    font-size: 0.8125rem;
    color: var(--faint);
    background: var(--rail);
    border-bottom: 1px solid var(--border);
  }
  .redes-lamina[data-estado='falta'] img { display: none; }
  .redes-lamina[data-estado='falta'] .redes-hueco { display: grid; }

  @media (max-width: 700px) {
    .redes { padding: 1rem 1rem 4rem; }
  }
</style>

<script>
  const copiar = document.getElementById('copiar-pie');
  copiar?.addEventListener('click', async () => {
    const texto = document.getElementById('pie-texto')?.textContent ?? '';
    try {
      await navigator.clipboard.writeText(texto);
      copiar.textContent = 'Copiado ✓';
      setTimeout(() => { copiar.textContent = 'Copiar texto'; }, 2000);
    } catch {
      copiar.textContent = 'Selecciónalo y copia a mano';
    }
  });

  const laminas = [...document.querySelectorAll<HTMLElement>('.redes-lamina')];
  const aviso = document.getElementById('redes-aviso') as HTMLElement | null;
  const avisoTexto = document.getElementById('redes-aviso-texto');
  const bajarTodas = document.getElementById('bajar-todas') as HTMLButtonElement | null;

  // Una lamina que no carga casi siempre significa que el despliegue aun no
  // termino: se dice con todas sus letras en vez de dejar el icono roto.
  function revisar() {
    const faltan = laminas.filter((l) => l.dataset.estado === 'falta').length;
    if (!aviso || !avisoTexto) return;
    aviso.hidden = faltan === 0;
    avisoTexto.textContent = faltan === laminas.length
      ? 'Las láminas todavía no están disponibles.'
      : `Faltan ${faltan} de ${laminas.length} láminas.`;
  }

  for (const lamina of laminas) {
    const img = lamina.querySelector('img') as HTMLImageElement;
    img.addEventListener('error', () => { lamina.dataset.estado = 'falta'; revisar(); });
    img.addEventListener('load', () => { delete lamina.dataset.estado; revisar(); });
    if (img.complete && img.naturalWidth === 0) { lamina.dataset.estado = 'falta'; revisar(); }
  }

  document.getElementById('redes-reintentar')?.addEventListener('click', () => {
    const sello = Date.now();
    for (const lamina of laminas) {
      const img = lamina.querySelector('img') as HTMLImageElement;
      img.src = img.src.split('?')[0] + '?v=' + sello;
    }
  });

  async function archivoDe(lamina: HTMLElement): Promise<File> {
    const img = lamina.querySelector('img') as HTMLImageElement;
    const nombre = lamina.dataset.nombre ?? 'lamina.png';
    const res = await fetch(img.src.split('?')[0], { cache: 'no-store' });
    if (!res.ok) throw new Error(`la lámina aún no está publicada (${res.status})`);
    return new File([await res.blob()], nombre, { type: 'image/png' });
  }

  // En el móvil el atributo download se ignora, así que primero se ofrece la
  // hoja de compartir —que trae «Guardar imagen»— y sólo si no la hay se baja.
  async function guardar(archivos: File[]) {
    if (archivos.length && navigator.canShare?.({ files: archivos })) {
      try {
        await navigator.share({ files: archivos });
        return;
      } catch (err) {
        if ((err as Error).name === 'AbortError') return;
      }
    }
    for (const archivo of archivos) {
      const url = URL.createObjectURL(archivo);
      const a = document.createElement('a');
      a.href = url;
      a.download = archivo.name;
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 10000);
      await new Promise((listo) => setTimeout(listo, 350));
    }
  }

  for (const lamina of laminas) {
    const boton = lamina.querySelector('a[download]') as HTMLAnchorElement;
    boton.addEventListener('click', async (ev) => {
      ev.preventDefault();
      const antes = boton.textContent;
      boton.textContent = '…';
      try {
        await guardar([await archivoDe(lamina)]);
        boton.textContent = antes;
      } catch (err) {
        lamina.dataset.estado = 'falta';
        revisar();
        boton.textContent = antes;
      }
    });
  }

  bajarTodas?.addEventListener('click', async () => {
    bajarTodas.disabled = true;
    const antes = bajarTodas.textContent;
    try {
      const archivos: File[] = [];
      for (let i = 0; i < laminas.length; i++) {
        bajarTodas.textContent = `Preparando ${i + 1}/${laminas.length}…`;
        archivos.push(await archivoDe(laminas[i]));
      }
      bajarTodas.textContent = 'Guardando…';
      await guardar(archivos);
      bajarTodas.textContent = antes;
    } catch (err) {
      bajarTodas.textContent = 'No están listas todavía';
      for (const lamina of laminas) {
        const img = lamina.querySelector('img') as HTMLImageElement;
        if (!img.complete || img.naturalWidth === 0) lamina.dataset.estado = 'falta';
      }
      revisar();
      setTimeout(() => { bajarTodas.textContent = antes; }, 4000);
    } finally {
      bajarTodas.disabled = false;
    }
  });
</script>
</html>
