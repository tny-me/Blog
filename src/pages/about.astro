---
import Shell from '../layouts/Shell.astro';
import { FOTO_PERFIL } from '../lib/perfil';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Shell title="Acerca" description="Sobre Tonny" crumb="Acerca" view="reader">
  <article>
    <img class="about-photo" src={`${base}${FOTO_PERFIL}`} alt="Tonny" width="96" height="96" />

    <h1 class="page-title">Sobre mí</h1>

    <div class="props">
      <div class="prop">
        <span class="prop-key">Autor</span>
        <span class="prop-val">
          <span class="prop-person">
            <img class="rail-photo" style="width:20px;height:20px;" src={`${base}${FOTO_PERFIL}`} alt="" />
            Tonny
          </span>
        </span>
      </div>
    </div>

    <hr class="divider" />

    <div class="body">
      <p>
        Aprendo sobre la intersección del diseño de arquitectura de datos, la
        ingeniería de software y el modelado de datos canónicos para optimizar
        y escalar operaciones.
      </p>
    </div>
  </article>
</Shell>
