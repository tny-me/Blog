---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const [featured, ...rest] = posts;
---

<Layout title="Inicio">
  <div class="container">
    <section class="home-intro">
      <p>Un espacio de reflexión sobre la fe, el espíritu y los momentos que merecen ser escritos.</p>
    </section>

    <ul class="post-list">
      {featured && (
        <PostCard
          title={featured.data.title}
          slug={featured.slug}
          date={featured.data.date}
          type={featured.data.type}
          description={featured.data.description}
          image={featured.data.image}
          featured={true}
        />
      )}
      {rest.map((post) => (
        <PostCard
          title={post.data.title}
          slug={post.slug}
          date={post.data.date}
          type={post.data.type}
          description={post.data.description}
          image={post.data.image}
        />
      ))}
    </ul>
  </div>
</Layout>
