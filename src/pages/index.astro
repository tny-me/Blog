---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Layout title="Inicio">
  <div class="container">
    <section class="hero">
      <p class="hero-name">Antonio Moreno</p>
      <p class="hero-tagline">Reflexiones de espíritu, fe y vida</p>
      <div class="hero-links">
        <a href={`${base}about`}>acerca</a>
        <a href="mailto:anthoniomoreno1@gmail.com">email</a>
      </div>
    </section>

    <ul class="post-list">
      {posts.map((post) => (
        <PostCard
          title={post.data.title}
          slug={post.slug}
          date={post.data.date}
          type={post.data.type}
          description={post.data.description}
          image={post.data.image}
        />
      ))}
    </ul>
  </div>
</Layout>
