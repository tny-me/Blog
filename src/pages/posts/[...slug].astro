---
import PostLayout from '../../layouts/PostLayout.astro';
import { getCollection } from 'astro:content';
import { resumenDe } from '../../lib/resumen';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

// Sin resumen propio, se saca del comienzo del texto: la vista previa al
// compartir nunca deberia caer en la descripcion generica del sitio.
const resumen = resumenDe(post.body, post.data.description);
---

<PostLayout
  title={post.data.title}
  slug={post.slug}
  description={post.data.description}
  resumen={resumen}
  date={post.data.date}
  category={post.data.category}
  image={post.data.image}
  tags={post.data.tags}
>
  <Content />
</PostLayout>
