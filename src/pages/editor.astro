---
import '../styles/global.css';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const posts = await getCollection('posts');
const categories = [...new Set(posts.map((p) => p.data.category))].sort();
const today = new Date().toISOString().slice(0, 10);
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Escribir — Tonny</title>
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <script is:inline>
    const t = localStorage.getItem('theme') ??
      (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    document.documentElement.setAttribute('data-theme', t);
  </script>
</head>

<body>
  <div class="ed-shell">
    <header class="ed-bar">
      <span class="reader-crumb">
        <a href={base} class="btn">←</a>
        <span id="ed-crumb">Entrada sin título</span>
        <span class="pill" id="ed-state">Borrador local</span>
      </span>
      <span class="reader-acts">
        <button class="btn" id="ed-new" type="button">Nueva</button>
        <button class="btn" id="ed-diagramas" type="button">Diagramas</button>
        <button class="btn" id="ed-list" type="button">Mis entradas</button>
        <button class="btn" id="ed-key" type="button">Acceso</button>
        <button class="btn btn-primary" id="ed-publish" type="button">Publicar</button>
      </span>
    </header>

    <!-- Panel de acceso: el token vive solo en este navegador -->
    <div class="ed-panel" id="ed-keypanel" hidden>
      <p class="eyebrow">Acceso de publicación</p>
      <p class="ed-note">
        Para publicar, el editor escribe el archivo de la entrada en tu repositorio de
        GitHub. Necesita un <strong>token de acceso personal</strong> con permiso de
        contenido sobre <code>tny-me/Blog</code>. Se guarda únicamente en este
        navegador (<code>localStorage</code>) y nunca viaja a otro sitio que no sea
        <code>api.github.com</code>.
      </p>
      <div class="ed-keyrow">
        <input type="password" id="ed-token" placeholder="github_pat_..." autocomplete="off" spellcheck="false" />
        <button class="btn btn-primary" id="ed-save-token" type="button">Guardar</button>
        <button class="btn" id="ed-clear-token" type="button">Borrar</button>
      </div>
      <p class="ed-note" id="ed-keystate"></p>
      <p class="ed-note">
        <a href="https://github.com/settings/personal-access-tokens/new" target="_blank" rel="noopener">
          Crear un token de alcance limitado →
        </a>
        Elige <em>Only select repositories → Blog</em> y en permisos
        <em>Repository permissions → Contents → Read and write</em>.
      </p>
    </div>

    <!-- Los diagramas se escriben como texto: aqui se ven dibujados -->
    <div class="ed-panel" id="ed-diagpanel" hidden>
      <p class="eyebrow">Diagramas de la entrada</p>
      <div id="ed-diagramas-out"></div>
    </div>

    <!-- Entradas publicadas: editar o eliminar -->
    <div class="ed-panel" id="ed-listpanel" hidden>
      <p class="eyebrow">Entradas publicadas</p>
      <p class="ed-note">
        Se leen directamente del repositorio. <strong>Editar</strong> carga la entrada
        aquí para modificarla; al publicar se sobrescribe. <strong>Eliminar</strong>
        la borra del sitio y no se puede deshacer desde aquí.
      </p>
      <div id="ed-posts"></div>
    </div>

    <main class="ed-doc">
      <div class="page-inner">
        <input class="ed-title" id="ed-titulo" placeholder="Sin título" autocomplete="off" />

        <div class="props ed-props">
          <label class="prop">
            <span class="prop-key">Fecha</span>
            <span class="prop-val"><input type="date" id="ed-fecha" value={today} /></span>
          </label>
          <label class="prop">
            <span class="prop-key">Categoría</span>
            <span class="prop-val">
              <input id="ed-categoria" list="ed-cats" placeholder="Ciencia de datos" autocomplete="off" />
              <datalist id="ed-cats">
                {categories.map((c) => <option value={c}></option>)}
              </datalist>
            </span>
          </label>
          <label class="prop">
            <span class="prop-key">Etiquetas</span>
            <span class="prop-val"><input id="ed-tags" placeholder="separadas, por, comas" autocomplete="off" /></span>
          </label>
          <label class="prop">
            <span class="prop-key">Resumen</span>
            <span class="prop-val"><input id="ed-desc" placeholder="Una línea que aparece en el listado" autocomplete="off" /></span>
          </label>
          <label class="prop">
            <span class="prop-key">Borrador</span>
            <span class="prop-val">
              <input type="checkbox" id="ed-draft" />
              <span class="ed-hint">Si se marca, se guarda pero no se publica en el sitio.</span>
            </span>
          </label>
        </div>

        <hr class="divider" />

        <div id="ed-body" class="body"></div>

        <p class="ed-hint ed-foot-hint">
          Escribe <kbd>/</kbd> para insertar títulos, listas, tablas, destacados,
          imágenes, vídeos, mapas conceptuales y diagramas de flujo.
          También funcionan los atajos de Markdown: <kbd># </kbd>, <kbd>- </kbd>,
          <kbd>&gt; </kbd>, <kbd>```</kbd>.
        </p>
      </div>
    </main>
  </div>

  <!-- Controles de tabla, visibles solo con el cursor dentro de una -->
  <div class="ed-tabla-bar" id="ed-tabla" hidden>
    <button class="btn" type="button" data-tabla="addRowBefore" title="Insertar fila encima">↑+</button>
    <button class="btn" type="button" data-tabla="addRowAfter" title="Insertar fila debajo">↓+</button>
    <button class="btn" type="button" data-tabla="deleteRow" title="Eliminar la fila">↕−</button>
    <span class="ed-tabla-sep"></span>
    <button class="btn" type="button" data-tabla="addColumnBefore" title="Insertar columna a la izquierda">←+</button>
    <button class="btn" type="button" data-tabla="addColumnAfter" title="Insertar columna a la derecha">→+</button>
    <button class="btn" type="button" data-tabla="deleteColumn" title="Eliminar la columna">↔−</button>
    <span class="ed-tabla-sep"></span>
    <button class="btn" type="button" data-tabla="toggleHeaderRow" title="Poner o quitar el encabezado">Encabezado</button>
    <button class="btn btn-danger" type="button" data-tabla="deleteTable" title="Eliminar la tabla">Borrar</button>
  </div>

  <!-- Menú de barra inclinada -->
  <div class="ed-slash" id="ed-slash" hidden></div>

  <div class="ed-toast" id="ed-toast" hidden></div>

  <input type="file" id="ed-file" accept="image/*" hidden />
</body>

<style is:global>
  .ed-shell { display: flex; flex-direction: column; min-height: 100vh; }

  .ed-bar {
    position: sticky;
    top: 0;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.65rem 1.25rem;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  .ed-panel {
    border-bottom: 1px solid var(--border);
    background: var(--rail);
    padding: 1.1rem 1.25rem;
  }
  .ed-panel .eyebrow { display: block; margin-bottom: 0.5rem; }
  .ed-note { font-size: 0.8125rem; color: var(--muted); line-height: 1.6; max-width: 70ch; margin-bottom: 0.6rem; }
  .ed-note code { font-family: var(--mono); font-size: 0.85em; background: var(--hover); border-radius: 3px; padding: 0.05em 0.3em; }
  .ed-note a { color: var(--blue); }
  .ed-keyrow { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 0.6rem; }
  .ed-keyrow input {
    flex: 1;
    min-width: 260px;
    font: inherit;
    font-size: 0.875rem;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.35rem 0.6rem;
  }

  .ed-post {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.6rem;
    border-radius: 4px;
    border-bottom: 1px solid var(--border);
  }
  .ed-post:last-child { border-bottom: none; }
  .ed-post:hover { background: var(--hover); }
  .ed-post-main { flex: 1; min-width: 0; }
  .ed-post-title { font-size: 0.875rem; font-weight: 500; }
  .ed-post-meta { font-size: 0.75rem; color: var(--faint); }
  .ed-post-acts { display: flex; gap: 0.3rem; flex-shrink: 0; }
  .btn-danger { color: #EB5757; }
  .btn-danger:hover { background: rgba(235, 87, 87, 0.1); color: #EB5757; }

  .ed-doc { flex: 1; padding: 3rem 3.5rem 8rem; }

  .ed-title {
    width: 100%;
    font: inherit;
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--text);
    background: none;
    border: none;
    outline: none;
    margin-bottom: 1.25rem;
  }
  .ed-title::placeholder { color: var(--faint); }

  .ed-props .prop { cursor: text; }
  .ed-props input[type="text"], .ed-props input[type="date"], .ed-props input:not([type]) {
    font: inherit;
    font-size: 0.875rem;
    color: var(--text);
    background: none;
    border: none;
    outline: none;
    width: 100%;
    padding: 0.15rem 0.25rem;
    border-radius: 3px;
  }
  .ed-props input:focus { background: var(--hover); }
  .ed-props input::placeholder { color: var(--faint); }
  .ed-hint { font-size: 0.75rem; color: var(--faint); }
  .ed-foot-hint { margin-top: 2rem; }
  .ed-hint kbd, .ed-foot-hint kbd {
    font-family: var(--mono);
    font-size: 0.9em;
    background: var(--hover);
    border-radius: 3px;
    padding: 0.05em 0.3em;
  }

  /* Lienzo de escritura */
  .ProseMirror { outline: none; min-height: 45vh; }
  .ProseMirror p.is-editor-empty:first-child::before {
    content: attr(data-placeholder);
    color: var(--faint);
    float: left;
    height: 0;
    pointer-events: none;
  }

  /* Menú de la barra inclinada */
  .ed-slash {
    position: fixed;
    z-index: 60;
    width: 260px;
    max-height: 300px;
    overflow-y: auto;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.14);
    padding: 0.3rem;
  }
  .ed-slash-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    text-align: left;
    padding: 0.4rem 0.5rem;
    border-radius: 4px;
    font-size: 0.875rem;
  }
  .ed-slash-item[data-active="true"] { background: var(--hover); }
  .ed-slash-ico {
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 4px;
    font-size: 0.8rem;
    color: var(--muted);
    flex-shrink: 0;
  }
  .ed-slash-sub { font-size: 0.75rem; color: var(--faint); }

  .ed-tabla-bar {
    position: fixed;
    z-index: 55;
    display: flex;
    align-items: center;
    gap: 0.15rem;
    padding: 0.25rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.1);
  }
  .ed-tabla-bar .btn { font-size: 0.75rem; padding: 0.2rem 0.4rem; }
  .ed-tabla-sep { width: 1px; height: 16px; background: var(--border); margin: 0 0.2rem; }

  .ed-toast {
    position: fixed;
    left: 50%;
    bottom: 1.5rem;
    transform: translateX(-50%);
    z-index: 70;
    max-width: min(90vw, 520px);
    background: var(--text);
    color: var(--bg);
    font-size: 0.875rem;
    border-radius: 6px;
    padding: 0.6rem 0.9rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
  }
  .ed-toast a { color: inherit; text-decoration: underline; }

  @media (max-width: 900px) {
    .ed-doc { padding: 1.75rem 1.25rem 6rem; }
    .ed-title { font-size: 1.875rem; }
    .ed-props .prop { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { Editor } from '@tiptap/core';
  import StarterKit from '@tiptap/starter-kit';
  import Placeholder from '@tiptap/extension-placeholder';
  import Link from '@tiptap/extension-link';
  import { TableKit } from '@tiptap/extension-table';
  import TurndownService from 'turndown';
  import { gfm } from 'turndown-plugin-gfm';
  import { marked } from 'marked';
  import { Destacado, Figura, Video, urlDeVideo, PLANTILLA_MAPA, PLANTILLA_FLUJO } from '../lib/editor-blocks';
  import { slugify } from '../lib/slug';

  const REPO = { owner: 'tny-me', name: 'Blog', branch: 'main' };
  const TOKEN_KEY = 'gh_pat';
  const DRAFT_KEY = 'editor_draft';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  const els = {
    crumb: $('ed-crumb'),
    state: $('ed-state'),
    keyBtn: $('ed-key'),
    keyPanel: $('ed-keypanel'),
    keyState: $('ed-keystate'),
    token: $<HTMLInputElement>('ed-token'),
    publish: $<HTMLButtonElement>('ed-publish'),
    titulo: $<HTMLInputElement>('ed-titulo'),
    fecha: $<HTMLInputElement>('ed-fecha'),
    categoria: $<HTMLInputElement>('ed-categoria'),
    tags: $<HTMLInputElement>('ed-tags'),
    desc: $<HTMLInputElement>('ed-desc'),
    draft: $<HTMLInputElement>('ed-draft'),
    listBtn: $('ed-list'),
    listPanel: $('ed-listpanel'),
    posts: $('ed-posts'),
    slash: $('ed-slash'),
    toast: $('ed-toast'),
    file: $<HTMLInputElement>('ed-file'),
  };

  // ── Avisos ────────────────────────────────────────────────
  let toastTimer: number | undefined;
  function toast(html: string, ms = 5000) {
    els.toast.innerHTML = html;
    els.toast.hidden = false;
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => { els.toast.hidden = true; }, ms);
  }

  // ── Token ─────────────────────────────────────────────────
  const getToken = () => localStorage.getItem(TOKEN_KEY) ?? '';

  function paintKeyState() {
    const has = !!getToken();
    els.keyState.textContent = has
      ? 'Hay un token guardado en este navegador.'
      : 'Sin token: puedes escribir y guardar el borrador, pero no publicar.';
    els.keyBtn.textContent = has ? 'Acceso ✓' : 'Acceso';
  }

  els.keyBtn.addEventListener('click', () => { els.keyPanel.hidden = !els.keyPanel.hidden; });

  $('ed-save-token').addEventListener('click', () => {
    const value = els.token.value.trim();
    if (!value) return;
    localStorage.setItem(TOKEN_KEY, value);
    els.token.value = '';
    paintKeyState();
    toast('Token guardado en este navegador.');
  });

  $('ed-clear-token').addEventListener('click', () => {
    localStorage.removeItem(TOKEN_KEY);
    paintKeyState();
    toast('Token borrado de este navegador.');
  });

  paintKeyState();

  // ── Editor ────────────────────────────────────────────────
  const editor = new Editor({
    element: $('ed-body'),
    extensions: [
      StarterKit.configure({ heading: { levels: [1, 2, 3] } }),
      TableKit.configure({ table: { resizable: false } }),
      Destacado,
      Figura,
      Video,
      Link.configure({ openOnClick: false }),
      Placeholder.configure({ placeholder: 'Escribe, o pulsa "/" para insertar un bloque…' }),
    ],
    content: '<p></p>',
    onUpdate: () => { saveDraft(); refreshSlash(); },
    onSelectionUpdate: () => refreshSlash(),
  });

  // ── Borrador local ────────────────────────────────────────
  let saveTimer: number | undefined;
  function saveDraft() {
    clearTimeout(saveTimer);
    saveTimer = window.setTimeout(() => {
      localStorage.setItem(DRAFT_KEY, JSON.stringify({
        titulo: els.titulo.value,
        fecha: els.fecha.value,
        categoria: els.categoria.value,
        tags: els.tags.value,
        desc: els.desc.value,
        draft: els.draft.checked,
        html: editor.getHTML(),
      }));
      els.state.textContent = 'Borrador guardado';
      els.crumb.textContent = els.titulo.value.trim() || 'Entrada sin título';
    }, 400);
  }

  function loadDraft() {
    const raw = localStorage.getItem(DRAFT_KEY);
    if (!raw) return;
    try {
      const d = JSON.parse(raw);
      els.titulo.value = d.titulo ?? '';
      if (d.fecha) els.fecha.value = d.fecha;
      els.categoria.value = d.categoria ?? '';
      els.tags.value = d.tags ?? '';
      els.desc.value = d.desc ?? '';
      els.draft.checked = !!d.draft;
      if (d.html) editor.commands.setContent(d.html);
      els.crumb.textContent = els.titulo.value.trim() || 'Entrada sin título';
      els.state.textContent = 'Borrador recuperado';
    } catch {
      /* borrador ilegible: se ignora y se empieza en limpio */
    }
  }

  [els.titulo, els.fecha, els.categoria, els.tags, els.desc, els.draft]
    .forEach((el) => el.addEventListener('input', saveDraft));

  els.titulo.addEventListener('input', () => {
    els.crumb.textContent = els.titulo.value.trim() || 'Entrada sin título';
  });

  loadDraft();

  // ── Menú de la barra inclinada ────────────────────────────
  type Cmd = { key: string; label: string; sub: string; ico: string; run: () => void };

  const chain = () => editor.chain().focus();

  const COMMANDS: Cmd[] = [
    { key: 'texto parrafo', label: 'Texto', sub: 'Párrafo normal', ico: '¶', run: () => chain().setParagraph().run() },
    { key: 'titulo 1 h1 encabezado', label: 'Título 1', sub: 'Sección grande', ico: 'H1', run: () => chain().toggleHeading({ level: 1 }).run() },
    { key: 'titulo 2 h2 encabezado', label: 'Título 2', sub: 'Sección mediana', ico: 'H2', run: () => chain().toggleHeading({ level: 2 }).run() },
    { key: 'titulo 3 h3 encabezado', label: 'Título 3', sub: 'Sección pequeña', ico: 'H3', run: () => chain().toggleHeading({ level: 3 }).run() },
    { key: 'lista vinetas bullet', label: 'Lista con viñetas', sub: 'Puntos sueltos', ico: '•', run: () => chain().toggleBulletList().run() },
    { key: 'lista numerada orden', label: 'Lista numerada', sub: 'Pasos en orden', ico: '1.', run: () => chain().toggleOrderedList().run() },
    { key: 'cita quote', label: 'Cita', sub: 'Texto destacado', ico: '❝', run: () => chain().toggleBlockquote().run() },
    { key: 'codigo code bloque', label: 'Código', sub: 'Bloque monoespaciado', ico: '{}', run: () => chain().toggleCodeBlock().run() },
    { key: 'divisor separador linea', label: 'Divisor', sub: 'Línea horizontal', ico: '—', run: () => chain().setHorizontalRule().run() },
    { key: 'imagen foto subir', label: 'Imagen', sub: 'Subir con pie de foto', ico: '🖼', run: () => els.file.click() },
    { key: 'enlace link url', label: 'Enlace', sub: 'Añadir una liga', ico: '↗', run: promptLink },
    { key: 'tabla cuadro filas columnas', label: 'Tabla', sub: '3 columnas con encabezado', ico: '▦',
      run: () => chain().insertTable({ rows: 3, cols: 3, withHeaderRow: true }).run() },
    { key: 'destacado nota callout informacion azul', label: 'Destacado · Nota', sub: 'Recuadro azul', ico: '🔵',
      run: () => (chain() as any).ponerDestacado('nota').run() },
    { key: 'destacado idea callout consejo', label: 'Destacado · Idea', sub: 'Recuadro ámbar', ico: '🟡',
      run: () => (chain() as any).ponerDestacado('idea').run() },
    { key: 'destacado aviso alerta advertencia cuidado', label: 'Destacado · Aviso', sub: 'Recuadro rojo', ico: '🔴',
      run: () => (chain() as any).ponerDestacado('aviso').run() },
    { key: 'mapa conceptual mental esquema ideas', label: 'Mapa conceptual', sub: 'Ramas desde un tema central', ico: '🕸',
      run: () => insertarDiagrama(PLANTILLA_MAPA) },
    { key: 'diagrama flujo proceso pasos decision', label: 'Diagrama de flujo', sub: 'Pasos y decisiones', ico: '⤳',
      run: () => insertarDiagrama(PLANTILLA_FLUJO) },
    { key: 'video youtube vimeo incrustar', label: 'Vídeo', sub: 'YouTube o Vimeo', ico: '▶', run: promptVideo },
  ];

  /** Los diagramas viajan como bloque de código en lenguaje mermaid. */
  function insertarDiagrama(plantilla: string) {
    editor.chain().focus()
      .insertContent({
        type: 'codeBlock',
        attrs: { language: 'mermaid' },
        content: [{ type: 'text', text: plantilla }],
      })
      .run();
    toast('Diagrama insertado. Pulsa «Diagramas» arriba para verlo dibujado.', 7000);
  }

  function promptVideo() {
    const pegado = window.prompt('Pega la dirección del vídeo (YouTube o Vimeo)');
    if (!pegado) return;
    const src = urlDeVideo(pegado);
    if (!src) return toast('No reconocí esa dirección. Deben ser de YouTube o Vimeo.', 8000);
    (editor.chain().focus() as any).ponerVideo(src).run();
  }

  let slashOpen = false;
  let slashFrom = 0;
  let slashItems: Cmd[] = [];
  let slashIndex = 0;

  /** Texto escrito tras la barra inclinada, si el cursor sigue dentro de ella. */
  function slashQuery(): { from: number; query: string } | null {
    const { state } = editor;
    const { from, empty } = state.selection;
    if (!empty) return null;
    const start = state.doc.resolve(from).start();
    const text = state.doc.textBetween(start, from, '\n', '\0');
    const match = /\/([\p{L}\p{N} ]{0,24})$/u.exec(text);
    if (!match) return null;
    return { from: from - match[0].length, query: match[1].trim().toLowerCase() };
  }

  const norm = (s: string) =>
    s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();

  function refreshSlash() {
    const hit = slashQuery();
    if (!hit) return closeSlash();

    const q = norm(hit.query);
    slashItems = q
      ? COMMANDS.filter((c) => norm(c.key + ' ' + c.label).includes(q))
      : COMMANDS;

    if (slashItems.length === 0) return closeSlash();

    slashFrom = hit.from;
    slashIndex = 0;
    slashOpen = true;
    paintSlash();
  }

  function paintSlash() {
    els.slash.innerHTML = '';
    slashItems.forEach((cmd, i) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'ed-slash-item';
      b.dataset.active = String(i === slashIndex);
      b.innerHTML =
        `<span class="ed-slash-ico">${cmd.ico}</span>` +
        `<span><span>${cmd.label}</span><br><span class="ed-slash-sub">${cmd.sub}</span></span>`;
      b.addEventListener('mousedown', (e) => { e.preventDefault(); pick(i); });
      els.slash.appendChild(b);
    });

    const coords = editor.view.coordsAtPos(editor.state.selection.from);
    const top = Math.min(coords.bottom + 6, window.innerHeight - 320);
    els.slash.style.left = `${Math.min(coords.left, window.innerWidth - 280)}px`;
    els.slash.style.top = `${Math.max(top, 8)}px`;
    els.slash.hidden = false;
  }

  function closeSlash() {
    slashOpen = false;
    els.slash.hidden = true;
  }

  function pick(i: number) {
    const cmd = slashItems[i];
    if (!cmd) return;
    editor.chain().focus().deleteRange({ from: slashFrom, to: editor.state.selection.from }).run();
    closeSlash();
    cmd.run();
  }

  editor.view.dom.addEventListener('keydown', (e: KeyboardEvent) => {
    if (!slashOpen) return;
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      slashIndex = (slashIndex + 1) % slashItems.length;
      paintSlash();
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      slashIndex = (slashIndex - 1 + slashItems.length) % slashItems.length;
      paintSlash();
    } else if (e.key === 'Enter' || e.key === 'Tab') {
      e.preventDefault();
      pick(slashIndex);
    } else if (e.key === 'Escape') {
      e.preventDefault();
      closeSlash();
    }
  }, true);

  function promptLink() {
    const url = window.prompt('Dirección del enlace');
    if (url) chain().setLink({ href: url }).run();
  }

  // ── Imágenes ──────────────────────────────────────────────
  els.file.addEventListener('change', async () => {
    const file = els.file.files?.[0];
    els.file.value = '';
    if (!file) return;
    if (!getToken()) return toast('Para subir imágenes hace falta guardar un token en «Acceso».');

    const name = `${Date.now()}-${slugify(file.name.replace(/\.[^.]+$/, ''))}.${(file.name.split('.').pop() ?? 'png').toLowerCase()}`;
    const path = `public/assets/img/${name}`;
    toast('Subiendo imagen…', 20000);
    try {
      const b64 = await fileToBase64(file);
      await putFile(path, b64, `Subir imagen ${name}`);
      (chain() as any).ponerFigura({ src: `/assets/img/${name}`, alt: file.name, pie: 'Pie de foto' }).run();
      toast('Imagen subida. Escribe encima del pie de foto para cambiarlo.', 7000);
    } catch (err) {
      toast(`No se pudo subir la imagen: ${(err as Error).message}`, 9000);
    }
  });

  function fileToBase64(file: File): Promise<string> {
    return new Promise((resolve, reject) => {
      const r = new FileReader();
      r.onload = () => resolve(String(r.result).split(',')[1]);
      r.onerror = () => reject(new Error('no se pudo leer el archivo'));
      r.readAsDataURL(file);
    });
  }

  // ── Publicación ───────────────────────────────────────────
  const turndown = new TurndownService({
    headingStyle: 'atx',
    codeBlockStyle: 'fenced',
    bulletListMarker: '-',
    emDelimiter: '*',
  });

  // Tablas al formato de Markdown extendido, que Astro ya sabe renderizar.
  turndown.use(gfm);

  // Los bloques propios no tienen equivalente en Markdown: se guardan como el
  // HTML que Astro renderizará, sin que turndown los desarme.
  turndown.addRule('bloquesPropios', {
    filter: (node) =>
      ['ASIDE', 'FIGURE', 'DIV'].includes(node.nodeName) &&
      /\b(destacado|figura|video)\b/.test((node as HTMLElement).className ?? ''),
    replacement: (_contenido, node) => `\n\n${(node as HTMLElement).outerHTML}\n\n`,
  });

  // El editor envuelve el contenido de cada <li> en un <p>, y eso produce listas
  // sueltas con un renglon en blanco entre puntos. Se quitan esos envoltorios.
  function tightHtml(html: string): string {
    const doc = new DOMParser().parseFromString(html, 'text/html');
    // El editor envuelve el contenido de listas y celdas en parrafos. Dentro de
    // una celda eso parte la fila en varias lineas y rompe la tabla.
    doc.querySelectorAll('li > p:only-child, th > p:only-child, td > p:only-child').forEach((p) => {
      p.replaceWith(...Array.from(p.childNodes));
    });

    // El editor decora las tablas con medidas y atributos que no aportan nada
    // al archivo publicado y estorban a la conversion a Markdown.
    doc.querySelectorAll('table colgroup').forEach((c) => c.remove());
    doc.querySelectorAll('table [style], table[style]').forEach((e) => e.removeAttribute('style'));
    doc.querySelectorAll('[colspan="1"]').forEach((e) => e.removeAttribute('colspan'));
    doc.querySelectorAll('[rowspan="1"]').forEach((e) => e.removeAttribute('rowspan'));

    // Filas totalmente vacias al final de una tabla: no aportan nada.
    doc.querySelectorAll('table tr').forEach((tr) => {
      if (![...tr.children].some((c) => (c.textContent ?? '').trim())) tr.remove();
    });

    return doc.body.innerHTML;
  }

  // Vineta con un solo espacio, en lugar de los tres que pone turndown por defecto.
  turndown.addRule('listItemCompacto', {
    filter: 'li',
    replacement: (content, node) => {
      const texto = content.replace(/^\n+/, '').replace(/\n+$/, '').replace(/\n/g, '\n  ');
      const padre = node.parentNode as HTMLElement;
      let marca = '- ';
      if (padre?.nodeName === 'OL') {
        const inicio = Number(padre.getAttribute('start') ?? 1);
        marca = `${inicio + Array.prototype.indexOf.call(padre.children, node)}. `;
      }
      return `${marca}${texto}\n`;
    },
  });

  /** Base64 seguro para texto con acentos. */
  function toBase64(text: string): string {
    const bytes = new TextEncoder().encode(text);
    let bin = '';
    bytes.forEach((b) => { bin += String.fromCharCode(b); });
    return btoa(bin);
  }

  async function gh(path: string, init?: RequestInit) {
    const res = await fetch(`https://api.github.com/repos/${REPO.owner}/${REPO.name}/${path}`, {
      ...init,
      headers: {
        Accept: 'application/vnd.github+json',
        Authorization: `Bearer ${getToken()}`,
        'X-GitHub-Api-Version': '2022-11-28',
        ...(init?.headers ?? {}),
      },
    });
    return res;
  }

  async function putFile(path: string, contentB64: string, message: string) {
    // Si el archivo ya existe hace falta su sha para sobrescribirlo.
    let sha: string | undefined;
    const probe = await gh(`contents/${path}?ref=${REPO.branch}`);
    if (probe.ok) sha = (await probe.json()).sha;
    else if (probe.status !== 404) throw new Error(await ghError(probe));

    const res = await gh(`contents/${path}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ message, content: contentB64, branch: REPO.branch, sha }),
    });
    if (!res.ok) throw new Error(await ghError(res));
    return res.json();
  }

  async function ghError(res: Response) {
    let detail = '';
    try { detail = (await res.json()).message ?? ''; } catch { /* respuesta sin cuerpo JSON */ }
    if (res.status === 401) return 'el token no es válido o caducó (401)';
    if (res.status === 403) return `sin permiso sobre el repositorio (403) ${detail}`;
    if (res.status === 404) return 'no se encontró el repositorio o el token no lo alcanza (404)';
    return `${res.status} ${detail}`;
  }

  function frontmatter(): string {
    const esc = (s: string) => s.replace(/"/g, '\\"');
    const tags = els.tags.value.split(',').map((t) => t.trim()).filter(Boolean);
    const lines = [
      '---',
      `title: "${esc(els.titulo.value.trim())}"`,
      `date: ${els.fecha.value}`,
      `category: "${esc(els.categoria.value.trim() || 'General')}"`,
    ];
    if (els.desc.value.trim()) lines.push(`description: "${esc(els.desc.value.trim())}"`);
    if (tags.length) lines.push(`tags: [${tags.map((t) => `"${esc(t)}"`).join(', ')}]`);
    if (els.draft.checked) lines.push('draft: true');
    lines.push('---', '', '');
    return lines.join('\n');
  }

  // ── Entradas publicadas: listar, editar, eliminar ─────────
  const DIR = 'src/content/posts';

  /** Ruta de la entrada que se esta editando, si se cargo una existente. */
  let editingPath: string | null = null;

  function fromBase64(b64: string): string {
    const bin = atob(b64.replace(/\s/g, ''));
    return new TextDecoder().decode(Uint8Array.from(bin, (c) => c.charCodeAt(0)));
  }

  /** Lector del frontmatter, acotado a los campos que escribe este editor. */
  function parseFrontmatter(md: string): { data: Record<string, any>; body: string } {
    const m = /^---\r?\n([\s\S]*?)\r?\n---\r?\n?/.exec(md);
    if (!m) return { data: {}, body: md };
    const data: Record<string, any> = {};
    for (const linea of m[1].split(/\r?\n/)) {
      const par = /^([A-Za-z_]+):\s*(.*)$/.exec(linea);
      if (!par) continue;
      const valor = par[2].trim();
      if (valor.startsWith('[') && valor.endsWith(']')) {
        data[par[1]] = valor.slice(1, -1).split(',')
          .map((x) => x.trim().replace(/^["']|["']$/g, ''))
          .filter(Boolean);
      } else {
        data[par[1]] = valor.replace(/^["']|["']$/g, '').replace(/\\"/g, '"');
      }
    }
    return { data, body: md.slice(m[0].length) };
  }

  async function deleteByPath(path: string, message: string) {
    const probe = await gh(`contents/${path}?ref=${REPO.branch}`);
    if (!probe.ok) throw new Error(await ghError(probe));
    const sha = (await probe.json()).sha;
    const res = await gh(`contents/${path}`, {
      method: 'DELETE',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ message, sha, branch: REPO.branch }),
    });
    if (!res.ok) throw new Error(await ghError(res));
  }

  async function cargarEntradas() {
    if (!getToken()) {
      els.posts.innerHTML = '<p class="ed-note">Guarda un token en «Acceso» para ver tus entradas.</p>';
      return;
    }
    els.posts.innerHTML = '<p class="ed-note">Cargando…</p>';
    try {
      const res = await gh(`contents/${DIR}?ref=${REPO.branch}`);
      if (!res.ok) throw new Error(await ghError(res));
      const archivos = (await res.json()).filter((f: any) => f.name.endsWith('.md'));

      const entradas = await Promise.all(archivos.map(async (f: any) => {
        const uno = await gh(`contents/${f.path}?ref=${REPO.branch}`);
        const md = uno.ok ? fromBase64((await uno.json()).content) : '';
        const { data } = parseFrontmatter(md);
        return { path: f.path, name: f.name, data };
      }));

      entradas.sort((a, b) => String(b.data.date ?? '').localeCompare(String(a.data.date ?? '')));
      pintarEntradas(entradas);
    } catch (err) {
      els.posts.innerHTML = `<p class="ed-note">No se pudieron cargar: ${(err as Error).message}</p>`;
    }
  }

  function pintarEntradas(entradas: Array<{ path: string; name: string; data: any }>) {
    els.posts.innerHTML = '';
    if (entradas.length === 0) {
      els.posts.innerHTML = '<p class="ed-note">No hay entradas todavía.</p>';
      return;
    }
    for (const entrada of entradas) {
      const fila = document.createElement('div');
      fila.className = 'ed-post';

      const main = document.createElement('div');
      main.className = 'ed-post-main';
      const titulo = document.createElement('div');
      titulo.className = 'ed-post-title';
      titulo.textContent = entrada.data.title ?? entrada.name;
      const meta = document.createElement('div');
      meta.className = 'ed-post-meta';
      meta.textContent = [
        entrada.data.date,
        entrada.data.category,
        entrada.data.draft === 'true' || entrada.data.draft === true ? 'borrador' : null,
      ].filter(Boolean).join(' · ');
      main.append(titulo, meta);

      const acts = document.createElement('div');
      acts.className = 'ed-post-acts';

      const ver = document.createElement('a');
      ver.className = 'btn';
      ver.textContent = 'Ver';
      ver.target = '_blank';
      ver.rel = 'noopener';
      ver.href = `/posts/${entrada.name.replace(/\.md$/, '')}`;

      const editar = document.createElement('button');
      editar.className = 'btn';
      editar.type = 'button';
      editar.textContent = 'Editar';
      editar.addEventListener('click', () => abrirEntrada(entrada.path));

      const borrar = document.createElement('button');
      borrar.className = 'btn btn-danger';
      borrar.type = 'button';
      borrar.textContent = 'Eliminar';
      borrar.addEventListener('click', () => borrarEntrada(entrada.path, titulo.textContent ?? ''));

      acts.append(ver, editar, borrar);
      fila.append(main, acts);
      els.posts.appendChild(fila);
    }
  }

  async function abrirEntrada(path: string) {
    try {
      const res = await gh(`contents/${path}?ref=${REPO.branch}`);
      if (!res.ok) throw new Error(await ghError(res));
      const { data, body } = parseFrontmatter(fromBase64((await res.json()).content));

      els.titulo.value = data.title ?? '';
      if (data.date) els.fecha.value = String(data.date).slice(0, 10);
      els.categoria.value = data.category ?? '';
      els.tags.value = Array.isArray(data.tags) ? data.tags.join(', ') : (data.tags ?? '');
      els.desc.value = data.description ?? '';
      els.draft.checked = data.draft === true || data.draft === 'true';
      editor.commands.setContent(await marked.parse(body));

      editingPath = path;
      els.crumb.textContent = els.titulo.value || path;
      els.state.textContent = 'Editando publicada';
      els.listPanel.hidden = true;
      saveDraft();
      window.scrollTo({ top: 0, behavior: 'smooth' });
      toast('Entrada cargada. Al publicar se sobrescribe.');
    } catch (err) {
      toast(`No se pudo abrir: ${(err as Error).message}`, 9000);
    }
  }

  async function borrarEntrada(path: string, titulo: string) {
    if (!window.confirm(`¿Eliminar «${titulo}»? Desaparecerá del sitio y no se puede deshacer desde aquí.`)) return;
    try {
      await deleteByPath(path, `Eliminar entrada: ${titulo}`);
      if (editingPath === path) nuevaEntrada();
      toast('Entrada eliminada. El sitio se actualiza en un minuto.');
      cargarEntradas();
    } catch (err) {
      toast(`No se pudo eliminar: ${(err as Error).message}`, 9000);
    }
  }

  function nuevaEntrada() {
    editingPath = null;
    els.titulo.value = '';
    els.categoria.value = '';
    els.tags.value = '';
    els.desc.value = '';
    els.draft.checked = false;
    els.fecha.value = new Date().toISOString().slice(0, 10);
    editor.commands.setContent('<p></p>');
    els.crumb.textContent = 'Entrada sin título';
    els.state.textContent = 'Borrador local';
    localStorage.removeItem(DRAFT_KEY);
    els.titulo.focus();
  }

  // ── Controles de tabla ────────────────────────────────────
  const barraTabla = $('ed-tabla');

  barraTabla.addEventListener('mousedown', (e) => {
    const boton = (e.target as HTMLElement).closest('[data-tabla]');
    if (!boton) return;
    e.preventDefault();   // no perder el cursor dentro de la celda
    const accion = boton.getAttribute('data-tabla')!;
    (editor.chain().focus() as any)[accion]().run();
    setTimeout(situarBarraTabla, 0);
  });

  function situarBarraTabla() {
    if (!editor.isActive('table')) {
      barraTabla.hidden = true;
      return;
    }
    const nodo = editor.view.domAtPos(editor.state.selection.from).node;
    const elemento = (nodo.nodeType === 1 ? nodo : nodo.parentElement) as HTMLElement | null;
    const tabla = elemento?.closest('table');
    if (!tabla) {
      barraTabla.hidden = true;
      return;
    }
    const caja = tabla.getBoundingClientRect();
    barraTabla.hidden = false;
    const alto = barraTabla.offsetHeight;
    // Debajo de la tabla si arriba no cabe.
    const arriba = caja.top - alto - 8;
    barraTabla.style.top = `${arriba > 60 ? arriba : caja.bottom + 8}px`;
    barraTabla.style.left = `${Math.max(8, caja.left)}px`;
  }

  editor.on('selectionUpdate', situarBarraTabla);
  editor.on('transaction', situarBarraTabla);
  // Al pinchar fuera del texto la barra deja de tener sentido. Los botones
  // conservan el foco (evitan el mousedown), asi que esto no los estorba.
  editor.on('blur', () => { barraTabla.hidden = true; });
  window.addEventListener('scroll', situarBarraTabla, true);
  window.addEventListener('resize', situarBarraTabla);

  // ── Vista previa de los diagramas ─────────────────────────
  const salidaDiag = $('ed-diagramas-out');
  const panelDiag = $('ed-diagpanel');

  $('ed-diagramas').addEventListener('click', async () => {
    panelDiag.hidden = !panelDiag.hidden;
    if (panelDiag.hidden) return;

    const codigos: string[] = [];
    editor.state.doc.descendants((nodo) => {
      if (nodo.type.name === 'codeBlock' && nodo.attrs.language === 'mermaid') {
        codigos.push(nodo.textContent);
      }
    });

    if (codigos.length === 0) {
      salidaDiag.innerHTML = '<p class="ed-note">Esta entrada no tiene diagramas. Inserta uno con «/».</p>';
      return;
    }

    salidaDiag.innerHTML = '<p class="ed-note">Dibujando…</p>';
    const { default: mermaid } = await import('mermaid');
    const { configuracionMermaid } = await import('../lib/diagramas');
    mermaid.initialize(
      configuracionMermaid(document.documentElement.getAttribute('data-theme') === 'dark')
    );

    salidaDiag.innerHTML = '';
    for (const [i, codigo] of codigos.entries()) {
      const caja = document.createElement('div');
      caja.className = 'diagrama';
      try {
        const { svg } = await mermaid.render(`vista-${i}-${codigos.length}`, codigo);
        caja.innerHTML = svg;
      } catch (err) {
        caja.innerHTML = `<p class="ed-note">Diagrama ${i + 1}: ${(err as Error).message}</p>`;
      }
      salidaDiag.appendChild(caja);
    }
  });

  els.listBtn.addEventListener('click', () => {
    els.listPanel.hidden = !els.listPanel.hidden;
    if (!els.listPanel.hidden) cargarEntradas();
  });

  $('ed-new').addEventListener('click', () => {
    if (els.titulo.value.trim() && !window.confirm('Se descartará lo que tienes en pantalla. ¿Seguir?')) return;
    nuevaEntrada();
  });

  els.publish.addEventListener('click', async () => {
    const titulo = els.titulo.value.trim();
    if (!titulo) return toast('Ponle un título a la entrada antes de publicar.');
    if (!getToken()) {
      els.keyPanel.hidden = false;
      return toast('Guarda primero un token en «Acceso».');
    }

    const slug = slugify(titulo);
    const path = `src/content/posts/${slug}.md`;
    const markdown = frontmatter() + turndown.turndown(tightHtml(editor.getHTML())).trim() + '\n';

    els.publish.disabled = true;
    els.publish.textContent = 'Publicando…';
    try {
      const editando = editingPath !== null;
      await putFile(path, toBase64(markdown), `${editando ? 'Actualizar' : 'Publicar'} entrada: ${titulo}`);

      // Si al editar cambio el titulo, cambia la ruta: se retira la anterior.
      let renombrada = false;
      if (editingPath && editingPath !== path) {
        await deleteByPath(editingPath, `Retirar ruta anterior de: ${titulo}`);
        renombrada = true;
      }
      editingPath = path;

      const url = els.draft.checked ? null : `https://tonny.blog/posts/${slug}`;
      els.state.textContent = editando ? 'Actualizada' : 'Publicado';
      toast(
        url
          ? `Entrada guardada.${renombrada ? ' Cambió el título, así que su dirección también.' : ''} En un minuto estará en <a href="${url}" target="_blank" rel="noopener">${url}</a>`
          : 'Entrada guardada como borrador: no aparecerá en el sitio hasta que desmarques «Borrador».',
        12000
      );
    } catch (err) {
      toast(`No se pudo publicar: ${(err as Error).message}`, 10000);
    } finally {
      els.publish.disabled = false;
      els.publish.textContent = 'Publicar';
    }
  });
</script>
</html>
