---
import '../styles/global.css';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** Texto de la barra superior del panel de contenido. */
  topbar?: string;
}

const {
  title,
  description = 'Ensayos sobre fe, espíritu y vida — Antonio Moreno',
  image,
  topbar,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const here = Astro.url.pathname.replace(/\/$/, '');

const isHere = (path: string) => here === path.replace(/\/$/, '');

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const tags = [...new Set(posts.flatMap((p) => p.data.tags ?? []))].slice(0, 8);
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="canonical" href={canonicalURL} />
  <title>{title} — Antonio Moreno</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={`${title} — Antonio Moreno`} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="alternate" type="application/rss+xml" title="Antonio Moreno" href={`${base}rss.xml`} />
  <script is:inline>
    // Antes de pintar, para que no haya destello de tema claro.
    const t = localStorage.getItem('theme') ??
      (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    document.documentElement.setAttribute('data-theme', t);
  </script>
</head>

<body>
  <div class="app">
    <aside class="sidebar">
      <a href={base} class="brand">
        <span class="brand-mark">AM</span>
        <span class="brand-name">Antonio M.</span>
      </a>

      <div class="side-group">
        <a href={base} class="side-link" aria-current={isHere(base) ? 'page' : undefined}>
          <span class="side-icon">◈</span> Inicio
        </a>
        <a href={`${base}about`} class="side-link" aria-current={isHere(`${base}about`) ? 'page' : undefined}>
          <span class="side-icon">◍</span> Acerca
        </a>
        <a href={`${base}rss.xml`} class="side-link">
          <span class="side-icon">⁂</span> RSS
        </a>
      </div>

      <div class="side-group">
        <p class="side-heading">Ensayos</p>
        {posts.map((post) => (
          <a
            href={`${base}posts/${post.slug}`}
            class="side-post"
            aria-current={isHere(`${base}posts/${post.slug}`) ? 'page' : undefined}
          >
            <span class="side-dot"></span>
            <span>{post.data.title}</span>
          </a>
        ))}
      </div>

      {tags.length > 0 && (
        <div class="side-group">
          <p class="side-heading">Etiquetas</p>
          <div class="side-tags">
            {tags.map((tag) => <span class="tag">#{tag}</span>)}
          </div>
        </div>
      )}

      <div class="side-foot">
        <span class="side-avatar">AM</span>
        <span class="side-foot-text">
          <span class="side-foot-name">Antonio Moreno</span>
          <a class="side-foot-mail" href="mailto:anthoniomoreno1@gmail.com">
            anthoniomoreno1@gmail.com
          </a>
        </span>
      </div>
    </aside>

    <div class="content">
      <div class="mobilebar">
        <a href={base} class="brand">
          <span class="brand-mark">AM</span>
          <span class="brand-name">Antonio M.</span>
        </a>
        <nav>
          <a href={base} aria-current={isHere(base) ? 'page' : undefined}>Inicio</a>
          <a href={`${base}about`} aria-current={isHere(`${base}about`) ? 'page' : undefined}>Acerca</a>
          <a href={`${base}rss.xml`}>RSS</a>
        </nav>
      </div>

      <div class="topbar">
        <div class="topbar-title label">
          <span class="side-icon">▤</span>
          <span>{topbar ?? title}</span>
        </div>
        <div class="topbar-actions">
          <button class="chip" id="theme-toggle" type="button">Oscuro</button>
        </div>
      </div>

      <main class="canvas">
        <slot />
      </main>
    </div>
  </div>
</body>

<script>
  const root = document.documentElement;
  const btn = document.getElementById('theme-toggle');

  function apply(theme: string) {
    root.setAttribute('data-theme', theme);
    localStorage.setItem('theme', theme);
    if (btn) btn.textContent = theme === 'dark' ? 'Claro' : 'Oscuro';
  }

  apply(root.getAttribute('data-theme') ?? 'light');

  btn?.addEventListener('click', () => {
    apply(root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
  });
</script>
</html>
