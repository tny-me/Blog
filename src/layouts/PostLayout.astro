---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description?: string;
  date: Date;
  type?: string;
  image?: string;
}

const { title, description, date, type = 'general', image } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const dateFormatted = date.toLocaleDateString('es-MX', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const typeLabels: Record<string, string> = {
  reflexion: 'Reflexión',
  carta: 'Carta',
  fe: 'Fe',
  espiritu: 'Espíritu',
  general: 'General',
};
---

<Layout title={title} description={description} image={image}>
  <div class="container post-page">
    <article>
      <header class="post-header">
        <div class="post-header-meta">
          {type !== 'general' && (
            <span class="post-type">{typeLabels[type] ?? type}</span>
          )}
        </div>
        <h1 class="post-title-main">{title}</h1>
        {description && <p class="post-description">{description}</p>}
      </header>

      <div class="post-byline">
        <img class="post-byline-photo" src={`${base}assets/img/ia/fotoperfil.png`} alt="Antonio Moreno" />
        <div>
          <p class="post-byline-name">Antonio Moreno</p>
          <time class="post-byline-date" datetime={date.toISOString()}>{dateFormatted}</time>
        </div>
      </div>

      {image && <img class="post-cover" src={image} alt={title} loading="lazy" />}

      <div class="post-body">
        <slot />
      </div>

      <footer class="post-footer">
        <a href={base} class="back-link">← Volver al inicio</a>
      </footer>
    </article>
  </div>
</Layout>
