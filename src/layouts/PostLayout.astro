---
import Shell from './Shell.astro';
import { categoryColor, slugify } from '../lib/slug';

interface Props {
  title: string;
  slug: string;
  description?: string;
  date: Date;
  category: string;
  image?: string;
  tags?: string[];
}

const { title, slug, description, date, category, image, tags = [] } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const dateFormatted = date.toLocaleDateString('es-MX', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Shell
  title={title}
  description={description}
  image={image}
  activeSlug={slug}
  crumb={title}
  view="reader"
>
  <article>
    <h1 class="page-title">{title}</h1>

    <div class="props">
      <div class="prop">
        <span class="prop-key">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
            <rect x="2" y="3" width="12" height="11" rx="2" />
            <path d="M2 6.5h12M5.5 2v2M10.5 2v2" />
          </svg>
          Publicado
        </span>
        <span class="prop-val">{dateFormatted}</span>
      </div>

      <div class="prop">
        <span class="prop-key">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
            <circle cx="8" cy="5.5" r="2.75" />
            <path d="M2.75 13.5a5.25 5.25 0 0 1 10.5 0" />
          </svg>
          Autor
        </span>
        <span class="prop-val">
          <span class="prop-person"><img class="rail-photo" style="width:20px;height:20px;" src={`${base}assets/img/ia/fotoperfil.png`} alt="" /> Antonio Moreno</span>
        </span>
      </div>

      <div class="prop">
        <span class="prop-key">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
            <rect x="2" y="2" width="5" height="5" rx="1" />
            <rect x="9" y="2" width="5" height="5" rx="1" />
            <rect x="2" y="9" width="5" height="5" rx="1" />
            <rect x="9" y="9" width="5" height="5" rx="1" />
          </svg>
          Categoría
        </span>
        <span class="prop-val">
          <a href={`${base}categoria/${slugify(category)}`} class="prop-chip">
            <span class="rail-swatch" style={`background:${categoryColor(category)};display:inline-block;margin-right:0.35rem;`}></span>
            {category}
          </a>
        </span>
      </div>

      {tags.length > 0 && (
        <div class="prop">
          <span class="prop-key">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
              <path d="M7.4 2H3a1 1 0 0 0-1 1v4.4a1 1 0 0 0 .3.7l6 6a1 1 0 0 0 1.4 0l4.4-4.4a1 1 0 0 0 0-1.4l-6-6A1 1 0 0 0 7.4 2Z" />
              <circle cx="5.25" cy="5.25" r="0.9" fill="currentColor" stroke="none" />
            </svg>
            Etiquetas
          </span>
          <span class="prop-val">
            {tags.map((tag) => <span class="tag">{tag}</span>)}
          </span>
        </div>
      )}
    </div>

    {description && (
      <div class="callout">
        <span class="callout-ico">💡</span>
        <span>{description}</span>
      </div>
    )}

    {image && <img class="cover" src={image} alt={title} loading="lazy" />}

    <div class="body">
      <slot />
    </div>

    <footer class="page-foot">
      <a href={base}>← Todas las entradas</a>
      <span>{dateFormatted}</span>
    </footer>
  </article>
</Shell>

<script>
  // Los diagramas viajan como bloques de codigo en lenguaje mermaid. Astro los
  // pasa por su resaltador, que marca el <pre> con data-language. Solo se
  // descarga la libreria si la entrada abierta tiene alguno.
  const bloques = document.querySelectorAll('pre[data-language="mermaid"]');
  if (bloques.length > 0) {
    const { default: mermaid } = await import('mermaid');
    const { configuracionMermaid } = await import('../lib/diagramas');
    mermaid.initialize(
      configuracionMermaid(document.documentElement.getAttribute('data-theme') === 'dark')
    );

    for (const [i, bloque] of [...bloques].entries()) {
      const caja = document.createElement('div');
      caja.className = 'diagrama';
      try {
        const { svg } = await mermaid.render(`diagrama-${i}`, bloque.textContent ?? '');
        caja.innerHTML = svg;
        bloque.replaceWith(caja);
      } catch {
        // Si el diagrama tiene un error de sintaxis se deja el codigo a la vista.
      }
    }
  }
</script>
