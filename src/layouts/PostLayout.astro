---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description?: string;
  date: Date;
  type?: string;
  image?: string;
}

const { title, description, date, type = 'general', image } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const dateFormatted = date.toLocaleDateString('es-MX', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const typeLabels: Record<string, string> = {
  reflexion: 'reflexión',
  carta: 'carta',
  fe: 'fe',
  espiritu: 'espíritu',
  general: '',
};
---

<Layout title={title} description={description} image={image}>
  <div class="container post-page">
    <article>
      <header class="post-header">
        <div class="post-header-top">
          <time datetime={date.toISOString()}>{dateFormatted}</time>
          {type !== 'general' && <span>{typeLabels[type]}</span>}
        </div>
        <h1 class="post-title-main">{title}</h1>
        {description && <p class="post-description">{description}</p>}
      </header>

      {image && <img class="post-cover" src={image} alt={title} loading="lazy" style="margin-bottom:2rem;" />}

      <div class="post-body">
        <slot />
      </div>

      <footer class="post-footer">
        <a href={base} class="back-link">← volver</a>
      </footer>
    </article>
  </div>
</Layout>
