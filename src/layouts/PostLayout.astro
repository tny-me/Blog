---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description?: string;
  date: Date;
  type?: string;
  image?: string;
}

const { title, description, date, type = 'general', image } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const dateFormatted = date.toLocaleDateString('es-MX', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const typeLabels: Record<string, string> = {
  reflexion: 'Reflexión',
  carta: 'Carta',
  fe: 'Fe',
  espiritu: 'Espíritu',
  general: 'Entrada',
};
---

<Layout title={title} description={description} image={image}>
  <div class="container post-page">
    <article>
      <header class="post-header">
        <p class="post-label">{typeLabels[type] ?? type}</p>
        <h1 class="post-title-main">{title}</h1>
        {description && <p class="post-description">{description}</p>}
        <p class="post-byline">{dateFormatted} · Antonio Moreno</p>
      </header>

      {image && <img class="post-cover" src={image} alt={title} loading="lazy" />}

      <div class="post-body">
        <slot />
      </div>

      <footer class="post-footer">
        <a href={base} class="back-link">← Volver al inicio</a>
      </footer>
    </article>
  </div>
</Layout>
